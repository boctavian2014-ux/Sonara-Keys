PTI_DEVICE=cuda

# Set to 1 on RunPod to load the model at process start (avoids cold first request + proxy 502).
# PTI_WARMUP_STARTUP=1

# Optional: set a shared secret; then clients must send header X-Sonara-Api-Key with the same value.
# PIANO_GPU_API_KEY=your-long-random-string

# Streaming stitch tunables
PTI_DEDUP_ONSET_EPS=0.06
PTI_DEDUP_OFFSET_EPS=0.12
PTI_SESSION_TTL_SEC=45
PTI_MAX_SESSION_NOTES=4000


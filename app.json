{
  "expo": {
    "name": "Sonara Keys",
    "slug": "sonara-keys",
    "scheme": "sonarakeys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aplicația ascultă pianul prin microfon pentru a detecta notele."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.devaieoodltd1.sonarakeys"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@edkimmel/expo-audio-stream",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "e755c1ea-db4f-43d4-91fc-97d776ca5e1c"
      }
    }
  }
}

# Copiază acest fișier ca `.env` și înlocuiește placeholder-ele.
# După modificări: npx expo start --clear

# Server Python Basic Pitch (POST /transcribe) — URL fără slash la final
# - Telefon fizic (aceeași Wi‑Fi ca PC-ul): http://192.168.x.x:8787
# - Emulator Android pe același PC: http://10.0.2.2:8787
EXPO_PUBLIC_TRANSCRIBE_API_URL=http://YOUR_PC_LAN_IP:8787

# Opțional: pune 1 ca să sari peste Basic Pitch pe telefon (TensorFlow)
# EXPO_PUBLIC_SKIP_ONDEVICE_BASIC_PITCH=1

# Kinde (conturi) — https://kinde.com — din aplicația Kinde (Frontend app / Native)
# EXPO_PUBLIC_KINDE_DOMAIN=https://YOUR_SUBDOMAIN.kinde.com
# EXPO_PUBLIC_KINDE_CLIENT_ID=your_native_client_id
# În Kinde → Applications → Callback URLs adaugă: sonarakeys://kinde_callback
